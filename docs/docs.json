{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Db2 for i MCP Server",
  "description": "MCP server for IBM Db2 for i: read-only SQL and catalog metadata for AI assistants.",
  "colors": {
    "primary": "#3159E8",
    "light": "#7D97FF",
    "dark": "#2447C9"
  },
  "logo": {
    "light": "/assets/brand/svg/lockup-primary.svg",
    "dark": "/assets/brand/svg/lockup-dark.svg"
  },
  "favicon": "/assets/brand/svg/favicon.svg",
  "appearance": {
    "default": "system"
  },
  "background": {
    "color": {
      "light": "#F3F1EB",
      "dark": "#121312"
    }
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "source": "/assets/fonts/Geist-Variable.woff2",
      "format": "woff2",
      "weight": 500
    },
    "body": {
      "family": "Geist",
      "source": "/assets/fonts/Geist-Variable.woff2",
      "format": "woff2",
      "weight": 400
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "quickstart",
          "client-setup",
          "use-cases"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "tools",
          "configuration",
          "custom-tools"
        ]
      },
      {
        "group": "Deployment",
        "pages": [
          "http-transport",
          "docker",
          "security"
        ]
      },
      {
        "group": "Contributing",
        "pages": [
          "development"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "icon": "globe",
          "href": "https://db2i-mcp.com"
        },
        {
          "anchor": "Blog",
          "icon": "newspaper",
          "href": "https://db2i-mcp.com/blog"
        },
        {
          "anchor": "GitHub",
          "icon": "github",
          "href": "https://github.com/Strom-Capital/mcp-server-db2i"
        },
        {
          "anchor": "npm",
          "icon": "npm",
          "href": "https://www.npmjs.com/package/mcp-server-db2i"
        }
      ]
    }
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/Strom-Capital/mcp-server-db2i"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Strom-Capital/mcp-server-db2i"
    }
  }
}
