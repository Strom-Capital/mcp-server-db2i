---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/posts';
import { formatDate, links, url } from '../../lib/links';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description} type="article">
  <article class="section">
    <div class="container">
      <div class="post-head">
        <div class="side">
          <a class="back" href={url('/blog')}><span aria-hidden="true">←</span> All posts</a>
          <p class="meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></p>
        </div>
        <div>
          <h1>{post.data.title}</h1>
          <p class="lead">{post.data.description}</p>
        </div>
      </div>
      <div class="post-body">
        <div class="side"></div>
        <div>
          {post.data.originalUrl && (
            <p class="original">The original announcement is <a href={post.data.originalUrl}>on r/IBMi</a>, with the discussion that followed.</p>
          )}
          <div class="prose"><Content /></div>
          <aside class="after">
            <p class="label">Questions or ideas?</p>
            <p>Open an issue on GitHub, or read the full <a href={links.changelog}>changelog</a>.</p>
            <div class="btn-row">
              <a class="btn btn--primary" href={links.issues}>Open an issue</a>
              <a class="link-rule" href={links.docs} data-ask-docs="blog">Ask the docs</a>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
  .post-head, .post-body { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-5); }
  @media (min-width: 1000px) { .post-head, .post-body { grid-template-columns: 200px minmax(0, 1fr); column-gap: 64px; } }
  .post-head { padding-bottom: var(--space-6); border-bottom: 1px solid var(--line-strong); margin-bottom: var(--space-6); }
  .side { display: grid; gap: var(--space-4); align-content: start; }
  .back { font: 500 12px/1.4 var(--font-mono); text-decoration: none; color: var(--muted); }
  .back:hover { color: var(--accent); }
  .meta { display: grid; gap: 2px; margin: 0; font: 12px/1.5 var(--font-mono); color: var(--muted); }
  h1 { font-size: clamp(2.2rem, 5vw, 3.8rem); max-width: 20ch; margin: 0; }
  .post-head .lead { margin: var(--space-5) 0 0; }
  .original { font: 13px/1.5 var(--font-mono); color: var(--muted); border-left: 2px solid var(--accent); padding-left: var(--space-3); max-width: 68ch; }
  .prose { font-size: 1.1rem; line-height: 1.7; max-width: 68ch; }
  .prose :global(h2) { font-size: 1.75rem; letter-spacing: -0.025em; margin: var(--space-7) 0 var(--space-4); padding-top: var(--space-4); border-top: 1px solid var(--line); }
  .prose :global(h3) { font-size: 1.15rem; margin: var(--space-6) 0 var(--space-3); }
  .prose :global(a) { text-decoration-color: var(--accent); }
  .prose :global(li) { margin-bottom: 6px; }
  .prose :global(pre) { font-size: 0.85rem; margin: var(--space-5) 0; }
  .prose :global(table) { border-collapse: collapse; width: 100%; font-size: 0.95rem; display: block; overflow-x: auto; margin: var(--space-5) 0; }
  .prose :global(th) { font: 500 11px/1.4 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); border-bottom: 1px solid var(--line-strong); padding: 8px 12px 8px 0; text-align: left; }
  .prose :global(td) { border-bottom: 1px solid var(--line); padding: 10px 12px 10px 0; text-align: left; vertical-align: top; }
  .prose :global(.shot) { margin: var(--space-6) 0; }
  .prose :global(.shot img) { width: 100%; max-width: 420px; height: auto; border: 1px solid var(--line); border-radius: var(--radius-code); }
  .prose :global(.shot figcaption) { margin-top: var(--space-2); font: 12px/1.5 var(--font-mono); color: var(--muted); }
  .prose :global(blockquote) { margin: var(--space-5) 0; padding-left: var(--space-4); border-left: 2px solid var(--line-strong); color: var(--muted); }
  .after { margin-top: var(--space-8); padding-top: var(--space-5); border-top: 1px solid var(--line-strong); max-width: 68ch; }
  .after .label { margin-bottom: var(--space-3); }
  .after p { margin-bottom: var(--space-5); }
</style>
