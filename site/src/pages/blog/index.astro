---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';
import { url } from '../../lib/links';

const posts = await getPosts();
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))];
---
<Base title="Blog" description="Release write-ups and posts about asking IBM i data new questions with AI assistants.">
  <section class="section">
    <div class="container">
      <div class="sec-head">
        <p class="label">Blog</p>
        <div>
          <h1>What each release changes, and why.</h1>
          <p class="lead">Release write-ups, and posts for business teams about getting more from ERP data on IBM i. Also as <a href={url('/rss.xml')}>RSS</a>.</p>
        </div>
      </div>
      {years.map((year) => (
        <section class="year">
          <h2 class="label">{year}</h2>
          <PostList posts={posts.filter((p) => p.data.date.getUTCFullYear() === year)} headingLevel="h3" />
        </section>
      ))}
    </div>
  </section>
</Base>

<style>
  h1 { font-size: clamp(2.4rem, 5.6vw, 4.5rem); }
  .year { display: grid; gap: var(--space-3); margin-top: var(--space-7); }
  .year:first-of-type { margin-top: 0; }
</style>
