    </script>
    <script is:inline define:vars={{ key, host }}>
      window.posthog.init(key, {
        api_host: host,
        defaults: '2026-05-30',
        cookieless_mode: 'always',
        person_profiles: 'identified_only',
        autocapture: false,
        capture_dead_clicks: false,
        disable_session_recording: true,
      });

      // Named events: copy buttons carry data-track, docs links are recognized by their origin.
      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target : null;
        if (!target || !window.posthog) return;
        const tracked = target.closest('[data-track]');
        if (tracked) window.posthog.capture(tracked.getAttribute('data-track'));
        const link = target.closest('a[href]');
        if (link) {
          const url = new URL(link.href, location.href);
          if (url.hostname === 'docs.db2i-mcp.com') window.posthog.capture('docs_link_clicked', { path: url.pathname, from: location.pathname });
        }
      });
    </script>
  </>
)}
