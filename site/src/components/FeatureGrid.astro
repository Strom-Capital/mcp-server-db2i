---
import { links } from '../lib/links';

interface Item { title: string; body: string; href: string }
interface Group { label: string; heading: string; items: Item[] }

const groups: Group[] = [
  {
    label: 'Safety',
    heading: 'Reads only, and only what you allow.',
    items: [
      { title: 'Read-only by design', href: links.security, body: 'A read-only database connection, a SQL validator that only accepts queries, and a timeout that cancels runaway statements on the IBM i itself.' },
      { title: 'Library allowlist and masking', href: links.allowlist, body: 'Limit queries and catalog browsing to the libraries you choose. Redact sensitive columns, or show only their last four characters.' },
      { title: 'IBM i checks the SQL', href: links.tools, body: 'validate_query parses a statement on the IBM i and checks every table and column against the catalog before anything runs.' },
    ],
  },
  {
    label: 'Connection',
    heading: 'Fits the network you have.',
    items: [
      { title: 'Three ways to connect', href: links.drivers, body: 'The IBM i Access ODBC driver by default, JT400 if you prefer JDBC, or Mapepire over SSH when only port 22 is open.' },
      { title: 'Several systems, one server', href: links.multipleSystems, body: 'Development, test and production side by side, each with its own driver, credentials and library allowlist.' },
    ],
  },
  {
    label: 'Auth',
    heading: 'Everyone signs in as themselves.',
    items: [
      { title: 'Sign in as yourself', href: links.oauth, body: 'Built-in OAuth 2.1. People add one URL in claude.ai, Cursor or Claude Code, sign in with their own IBM i profile and keep the authority they already have.' },
    ],
  },
  {
    label: 'Context',
    heading: 'Answers in your own terms.',
    items: [
      { title: 'Your business definitions', href: links.customTools, body: 'Describe tables and status codes in YAML, and turn your vetted queries into named tools with bound parameters.' },
      { title: 'Find your way around', href: links.tools, body: 'Search tables and columns across libraries, profile a table, read DDL, and look up procedures, functions and index advice.' },
    ],
  },
  {
    label: 'Operations',
    heading: 'Every call on the record.',
    items: [
      { title: 'Audit log', href: links.auditLog, body: 'Every tool call written as one JSON line, with the SQL hashed by default, ready for your log pipeline.' },
    ],
  },
];
---
<section class="section" id="features">
  <div class="container">
    <div class="sec-head">
      <p class="label">What you get</p>
      <div>
        <h2>Built for production IBM i systems.</h2>
        <p class="lead">The read-only checks are always on. The allowlist, masking and audit log are one setting each. Every control is documented, so your IBM i team can see exactly what is enforced and where.</p>
      </div>
    </div>
    <div class="groups">
      {groups.map((g) => (
        <div class="group">
          <div class="lead-col">
            <p class="label">{g.label}</p>
            <h3>{g.heading}</h3>
          </div>
          <ul class="rows">
            {g.items.map((item) => (
              <li>
                <a class="item" href={item.href}>
                  <b>{item.title}</b>
                  <span>{item.body}</span>
                  <em aria-hidden="true">→</em>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .groups { border-top: 1px solid var(--line-strong); }
  .group { display: grid; gap: 16px 64px; padding-block: 28px 36px; border-bottom: 1px solid var(--line); }
  @media (min-width: 900px) { .group { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); } }
  .lead-col { display: grid; gap: 12px; align-content: start; }
  .group h3 { margin: 0; max-width: 16ch; font-size: 1.75rem; font-weight: 400; line-height: 1.1; letter-spacing: -0.025em; }
  .item { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 24px; padding: 14px 0; text-decoration: none; color: var(--fg); }
  .rows > li:first-child .item { padding-top: 2px; }
  .item b { font-weight: 500; }
  .item span { grid-column: 1; color: var(--muted); max-width: 62ch; font-size: 0.95rem; }
  .item em { grid-row: 1 / span 2; grid-column: 2; font-style: normal; color: var(--muted); transition: transform 0.15s, color 0.15s; }
  .item:hover { color: var(--fg); }
  .item:hover em { color: var(--accent); transform: translateX(3px); }
</style>
