---
import DemoChat from './DemoChat.astro';
import CopyCommand from './CopyCommand.astro';
import Spec from './Spec.astro';
import { links, url } from '../lib/links';
---
<section class="hero">
  <div class="container top">
    <h1>Ask your IBM i<br />in plain language.</h1>
    <div class="copy">
      <p class="sub">
        Give Claude, Cursor and other AI assistants <strong>read-only access to Db2 for i</strong>. It connects through
        the host servers your IBM i already runs, or over SSH, so there is nothing new to install on the system.
      </p>
      <div class="actions">
        <a class="btn btn--primary" href={links.quickstart}>Get started <span aria-hidden="true">→</span></a>
        <CopyCommand command="npx mcp-server-db2i" />
      </div>
    </div>
    <Spec
      title="At a glance"
      rows={[
        { key: 'Transport', value: 'stdio · HTTP' },
        { key: 'Auth', value: 'OAuth 2.1' },
        { key: 'Database', value: 'Db2 for i' },
        { key: 'Drivers', value: 'ODBC · JT400 · Mapepire' },
        { key: 'On the IBM i', value: 'Nothing to install' },
        { key: 'Access', value: 'READ ONLY', on: true },
      ]}
    />
  </div>

  <div class="container">
    <DemoChat />
  </div>

  <div class="container start">
    <div class="mini-head">
      <p class="label">Where to start</p>
      <h2>Two ways in, depending on your role.</h2>
    </div>
    <div class="paths">
      <a class="path" href={url('/business')}>
        <span class="label">For business teams</span>
        <strong>For the questions that don't have a report yet</strong>
        <span class="muted">How it fits next to your ERP screens, reports, Excel or BI, and what your IT team needs to agree to.</span>
        <span class="go">Read more <span aria-hidden="true">→</span></span>
      </a>
      <a class="path" href={links.quickstart}>
        <span class="label">For IBM i teams</span>
        <strong>Connect a client in a few minutes</strong>
        <span class="muted">Install from npm or Docker, set three environment variables and point Claude, Cursor or Claude Code at it.</span>
        <span class="go">Quickstart <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </div>
</section>

<style>
  /* Headline on its own row; below it the intro and the spec block, top-aligned */
  .top { display: grid; gap: var(--space-6) 64px; padding-block: 72px 56px; }
  .top h1 { margin: 0 0 var(--space-3); }
  @media (min-width: 1000px) {
    .top { grid-template-columns: minmax(0, 1fr) 360px; align-items: start; padding-block: 112px 80px; }
    .top h1 { grid-column: 1 / -1; }
  }
  .sub { margin: 0; font-size: 1.15rem; line-height: 1.55; color: var(--muted); max-width: 46ch; }
  .sub strong { color: var(--fg); }
  .actions { display: flex; flex-wrap: wrap; align-items: stretch; gap: 12px; margin-top: 32px; }
  .actions :global(.copycmd) { min-height: 46px; }

  .start { margin-top: var(--space-8); }
  .paths { display: grid; border-top: 1px solid var(--line-strong); }
  @media (min-width: 760px) { .paths { grid-template-columns: 1fr 1fr; } }
  .path { display: grid; gap: var(--space-2); align-content: start; padding: 22px 0 28px; text-decoration: none; color: var(--fg); }
  .path + .path { border-top: 1px solid var(--line); }
  @media (min-width: 760px) {
    .path { padding-right: 32px; }
    .path + .path { border-top: 0; border-left: 1px solid var(--line); padding-left: 32px; padding-right: 0; }
  }
  .path strong { font-size: 1.5rem; font-weight: 400; letter-spacing: -0.025em; line-height: 1.2; margin-top: 6px; }
  .path .muted { max-width: 48ch; }
  .go { color: var(--fg); font-weight: 500; margin-top: var(--space-2); }
  .path:hover { color: var(--fg); }
  .path:hover .go { color: var(--accent); }
</style>
