---
/** A Lucide icon in the green tile used on cards across the site. */
import type { AstroComponent } from '@lucide/astro';

interface Props { icon: AstroComponent }
const { icon: Icon } = Astro.props;
---
<span class="icon-tile" aria-hidden="true"><Icon size={20} stroke-width={1.75} /></span>

<style>
  .icon-tile { display: inline-grid; place-items: center; width: 40px; height: 40px; margin-bottom: var(--space-3); border-radius: 10px; color: var(--accent); background: var(--accent-soft); border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent); }
</style>
