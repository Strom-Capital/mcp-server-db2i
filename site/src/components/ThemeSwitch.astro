---
/**
 * Cycles the theme: system, light, dark. The choice is kept in localStorage
 * and applied as data-theme on <html>. The inline script in Base.astro's head
 * applies it before first paint, so the page never flashes the wrong theme.
 */
---
<button type="button" class="theme-switch" data-theme-switch aria-label="Theme: system. Switch to light." title="Theme: system">
  <span data-icon="system">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="7.25" /><path d="M12 4.75a7.25 7.25 0 0 1 0 14.5z" class="fill" /></svg>
  </span>
  <span data-icon="light">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.75v2.5M12 18.75v2.5M2.75 12h2.5M18.75 12h2.5M5.46 5.46l1.77 1.77M16.77 16.77l1.77 1.77M5.46 18.54l1.77-1.77M16.77 7.23l1.77-1.77" /></svg>
  </span>
  <span data-icon="dark">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M19.25 14.6A7.75 7.75 0 0 1 9.4 4.75a7.75 7.75 0 1 0 9.85 9.85z" /></svg>
  </span>
</button>

<script>
  type Theme = 'system' | 'light' | 'dark';
  const order: Theme[] = ['system', 'light', 'dark'];
  const key = 'theme';

  function read(): Theme {
    try {
      const value = localStorage.getItem(key);
      return value === 'light' || value === 'dark' ? value : 'system';
    } catch {
      return 'system';
    }
  }

  function apply(theme: Theme) {
    const root = document.documentElement;
    if (theme === 'system') root.removeAttribute('data-theme');
    else root.setAttribute('data-theme', theme);
    try {
      if (theme === 'system') localStorage.removeItem(key);
      else localStorage.setItem(key, theme);
    } catch {
      // Storage blocked: the choice lasts for this page only.
    }
    const next = order[(order.indexOf(theme) + 1) % order.length];
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-switch]')) {
      button.dataset.current = theme;
      button.setAttribute('aria-label', `Theme: ${theme}. Switch to ${next}.`);
      button.title = `Theme: ${theme}`;
    }
    document.dispatchEvent(new CustomEvent('themechange', { detail: theme }));
  }

  let current = read();
  apply(current);
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-switch]')) {
    button.addEventListener('click', () => {
      current = order[(order.indexOf(current) + 1) % order.length];
      apply(current);
    });
  }
</script>

<style>
  .theme-switch { display: inline-grid; place-items: center; width: 34px; height: 34px; padding: 0; color: var(--muted); background: none; border: 1px solid var(--line); border-radius: var(--radius-btn); cursor: pointer; }
  .theme-switch:hover { color: var(--fg); border-color: var(--line-strong); }
  .theme-switch svg { display: block; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .theme-switch svg .fill { fill: currentColor; stroke: none; }
  .theme-switch span { display: none; line-height: 0; }
  .theme-switch:not([data-current]) [data-icon='system'],
  .theme-switch[data-current='system'] [data-icon='system'],
  .theme-switch[data-current='light'] [data-icon='light'],
  .theme-switch[data-current='dark'] [data-icon='dark'] { display: block; }
</style>
