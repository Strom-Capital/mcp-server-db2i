---
import { audienceLabel, type Post } from '../lib/posts';
import { formatDate, url } from '../lib/links';

interface Props { posts: Post[]; headingLevel?: 'h2' | 'h3' }
const { posts, headingLevel: H = 'h3' } = Astro.props;
---
<ul class="posts rows">
  {posts.map((post) => (
    <li>
      <a class="post" href={url(`/blog/${post.id}`)}>
        <span class="meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>{audienceLabel[post.data.audience]}</span></span>
        <span class="body">
          <H class="title">{post.data.title}</H>
          <span class="desc">{post.data.description}</span>
        </span>
        <em aria-hidden="true">→</em>
      </a>
    </li>
  ))}
</ul>

<style>
  .posts { border-top: 1px solid var(--line-strong); }
  .posts li { container-type: inline-size; }
  .post { display: grid; gap: 8px 32px; padding: 18px 0 20px; text-decoration: none; color: var(--fg); }
  @container (min-width: 640px) { .post { grid-template-columns: 180px minmax(0, 1fr) auto; } }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 12px; font: 12px/1.5 var(--font-mono); color: var(--muted); }
  @container (min-width: 640px) { .meta { flex-direction: column; gap: 2px; } }
  .body { display: grid; gap: 6px; min-width: 0; }
  .title { margin: 0; font-size: 1.2rem; font-weight: 500; letter-spacing: -0.015em; }
  .desc { color: var(--muted); font-size: 0.95rem; max-width: 64ch; }
  em { font-style: normal; color: var(--muted); display: none; transition: transform 0.15s, color 0.15s; }
  @container (min-width: 640px) { em { display: block; } }
  .post:hover { color: var(--fg); }
  .post:hover em { color: var(--accent); transform: translateX(3px); }
</style>
