---
/**
 * A static example exchange, set as three columns: the question, the tool
 * calls the server makes, and the answer. Generic data only: never a real system.
 */
---
<figure class="query" aria-label="Example: an assistant answers a question using the MCP server">
  <div class="cols">
    <div class="col">
      <div class="head"><span class="label">01 / Question</span><span class="who">Claude</span></div>
      <p class="question">Which customers have the most open orders right now?</p>
    </div>
    <div class="col on">
      <div class="head"><span class="label">02 / Tool calls</span><span class="who">mcp-server-db2i</span></div>
      <div class="call">
        <div class="call-h"><b>describe_table</b><span>MYLIB.ORDERHDR</span></div>
        <p>Table note: <code>STATUS = 'O'</code> means open.</p>
      </div>
      <div class="call">
        <div class="call-h"><b>execute_query</b><span class="tag">read-only</span></div>
        <pre><code><span class="k">SELECT</span> C.NAME, COUNT(*) <span class="k">AS</span> OPEN_ORDERS
<span class="k">FROM</span> MYLIB.ORDERHDR H
<span class="k">JOIN</span> MYLIB.CUSTOMERS C <span class="k">ON</span> C.CUSTNO = H.CUSTNO
<span class="k">WHERE</span> H.STATUS = 'O'
<span class="k">GROUP BY</span> C.NAME
<span class="k">ORDER BY</span> OPEN_ORDERS <span class="k">DESC</span>
<span class="k">FETCH FIRST</span> 3 <span class="k">ROWS ONLY</span></code></pre>
      </div>
    </div>
    <div class="col">
      <div class="head"><span class="label">03 / Result</span><span class="who">3 rows</span></div>
      <p class="answer">Three customers account for most of the open orders.</p>
      <table>
        <thead><tr><th>Customer</th><th>Open orders</th></tr></thead>
        <tbody>
          <tr><td>Acme Tools</td><td>14</td></tr>
          <tr><td>Birch Supply</td><td>9</td></tr>
          <tr><td>Harbor Parts</td><td>7</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</figure>

<style>
  .query { margin: 0; min-width: 0; }
  .cols { display: grid; border-bottom: 1px solid var(--line); position: relative; }
  .col { position: relative; }
  /* The data path: a line along the top with one square at the start of each column, as in Architecture.astro */
  .cols::before { content: ''; position: absolute; left: 0; right: 0; top: 8px; height: 1px; background: var(--line-strong); }
  .cols { padding-top: 18px; }
  .col::before { content: ''; position: absolute; left: 0; top: -13px; width: 7px; height: 7px; background: var(--bg); border: 1px solid var(--line-strong); }
  .col.on::before { background: var(--accent); border-color: var(--accent); }
  .cols::after { content: ''; position: absolute; top: 7px; left: 0; width: 44px; height: 3px; background: var(--accent); animation: run 5.5s cubic-bezier(0.6, 0, 0.4, 1) infinite; }
  @keyframes run {
    0% { left: 0; opacity: 0; }
    8% { opacity: 1; }
    92% { opacity: 1; }
    100% { left: calc(100% - 44px); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .cols::after { animation: none; left: 34%; } }
  @media (max-width: 999px) { .col + .col::before { display: none; } }
  @media (min-width: 1000px) {
    .cols { grid-template-columns: 1fr 1.35fr 1fr; }
    .col + .col::before { left: 32px; }
  }
  .col { display: grid; gap: 18px; align-content: start; padding: 22px 0 32px; min-width: 0; }
  .col + .col { border-top: 1px solid var(--line); }
  @media (min-width: 1000px) {
    .col { padding: 22px 32px 40px; }
    .col:first-child { padding-left: 0; }
    .col:last-child { padding-right: 0; }
    .col + .col { border-top: 0; border-left: 1px solid var(--line); }
  }
  .head { display: flex; justify-content: space-between; gap: 12px; }
  .who { font: 12px/1.4 var(--font-mono); color: var(--muted); }
  .question { margin: 0; font-size: clamp(1.5rem, 2.4vw, 1.9rem); line-height: 1.2; letter-spacing: -0.02em; text-wrap: balance; }
  .call { display: grid; gap: 8px; min-width: 0; }
  .call-h { display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: baseline; font: 13px/1.4 var(--font-mono); }
  .call-h b { font-weight: 500; }
  .call-h span { color: var(--muted); }
  .call-h .tag { font: 500 10.5px/1 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); border: 1px solid currentColor; padding: 3px 6px 2px; border-radius: 2px; }
  .call p { margin: 0; font-size: 0.9rem; color: var(--muted); }
  pre { margin: 0; font-size: 12.5px; }
  pre code { font-size: inherit; }
  .k { color: var(--accent); }
  .answer { margin: 0; }
  table { width: 100%; border-collapse: collapse; }
  th { font: 500 11px/1.4 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); text-align: left; padding: 0 0 8px; border-bottom: 1px solid var(--line-strong); }
  td { padding: 11px 0; border-bottom: 1px solid var(--line); }
  td:last-child, th:last-child { text-align: right; font-variant-numeric: tabular-nums; }
</style>
