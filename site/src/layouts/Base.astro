---
import '@fontsource-variable/geist';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import faviconSvg from '../../../docs/assets/brand/svg/favicon.svg?raw';
import Logo from '../components/Logo.astro';
import AskDocs from '../components/AskDocs.astro';
import CodeCopy from '../components/CodeCopy.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import { links, url } from '../lib/links';

interface Props {
  title: string;
  description: string;
  /** Up to three questions shown when the docs assistant opens. */
  starterQuestions?: string[];
  type?: 'website' | 'article';
}

const {
  title,
  description,
  type = 'website',
  starterQuestions = [
    'How do I connect Claude Desktop to my IBM i?',
    'Which driver should I use: ODBC, JT400 or Mapepire?',
    'How does the server keep queries read-only?',
  ],
} = Astro.props;

const siteName = 'Db2 for i MCP Server';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const current = (prefix: string) => (path === url(prefix) || path.startsWith(url(prefix) + '/') ? 'page' : undefined);

const favicon = 'data:image/svg+xml,' + encodeURIComponent(faviconSvg);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Db2 for i MCP Server blog" href={url('/rss.xml')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Apply a saved theme before first paint. See ThemeSwitch.astro.
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.setAttribute('data-theme', theme);
      } catch {}
    </script>
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href={url('/')} aria-label="db2i/mcp home">
          <Logo variant="lockup" height={20} />
        </a>
        <nav aria-label="Main">
          <a href={url('/')} aria-current={path === url('/') ? 'page' : undefined}>Product</a>
          <a href={url('/business')} aria-current={current('/business')}>For business</a>
          <a href={url('/blog')} aria-current={current('/blog')}>Blog</a>
          <a href={links.docs}>Docs</a>
          <a href={links.github}>GitHub</a>
          <ThemeSwitch />
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="cols">
          <div class="about">
            <a class="brand" href={url('/')} aria-label="db2i/mcp home"><Logo variant="lockup" height={20} /></a>
            <p class="muted">An open-source MCP server for IBM Db2 for i. MIT licensed.</p>
          </div>
          <div>
            <h2 class="label">Project</h2>
            <ul>
              <li><a href={links.docs}>Docs</a></li>
              <li><a href={url('/blog')}>Blog</a></li>
              <li><a href={url('/rss.xml')}>RSS</a></li>
              <li><a href={links.changelog}>Changelog</a></li>
            </ul>
          </div>
          <div>
            <h2 class="label">Get it</h2>
            <ul>
              <li><a href={links.npm}>npm</a></li>
              <li><a href={links.github}>GitHub</a></li>
              <li><a href={links.registry}>MCP Registry</a></li>
            </ul>
          </div>
          <div>
            <h2 class="label">Community</h2>
            <ul>
              <li><a href={links.issues}>Issues</a></li>
              <li><a href={links.sponsor}>Sponsor</a></li>
            </ul>
          </div>
        </div>
        <p class="legal">
          <span>db2i/mcp · npm: <a href={links.npm}>mcp-server-db2i</a> · MIT</span>
          <span>IBM, IBM i and Db2 are trademarks of International Business Machines Corporation. This project is not affiliated with IBM.</span>
        </p>
      </div>
    </footer>

    <AskDocs starterQuestions={starterQuestions} />
    <CodeCopy />
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 8px; background: var(--surface); padding: 8px 12px; z-index: 10; }
  .skip:focus { left: 8px; }

  .site-header { position: sticky; top: 0; z-index: 5; background: var(--bg); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); min-height: 64px; }
  .brand { display: inline-flex; align-items: center; color: var(--fg); text-decoration: none; }
  .brand:hover { color: var(--fg); }
  nav { display: flex; align-items: center; gap: 28px; font-size: 0.9rem; }
  nav a { display: inline-flex; align-items: center; min-height: 34px; color: var(--muted); text-decoration: none; white-space: nowrap; }
  nav a:hover, nav a[aria-current] { color: var(--fg); }

  @media (max-width: 759px) {
    nav { gap: var(--space-4); font-size: 0.85rem; }
    nav a:first-child { display: none; }
  }
  @media (max-width: 479px) {
    .bar { flex-wrap: wrap; padding-block: 10px; }
    nav { width: 100%; justify-content: space-between; gap: 10px; }
  }

  .site-footer { border-top: 1px solid var(--line-strong); padding: var(--space-7) 0 var(--space-5); margin-top: var(--space-8); font-size: 0.95rem; }
  .cols { display: grid; gap: var(--space-6); grid-template-columns: 1fr 1fr; }
  .about { grid-column: 1 / -1; }
  @media (min-width: 760px) { .cols { grid-template-columns: 2fr 1fr 1fr 1fr; } .about { grid-column: auto; } }
  .about p { margin-top: var(--space-4); max-width: 24rem; }
  .site-footer .label { margin-bottom: var(--space-3); }
  .site-footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .site-footer ul a { text-decoration: none; }
  .legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-3) var(--space-6); margin: var(--space-7) 0 0; padding-top: var(--space-4); border-top: 1px solid var(--line); font: 12px/1.5 var(--font-mono); color: var(--muted); }
</style>
