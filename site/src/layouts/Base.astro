---
import '@fontsource-variable/geist';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import faviconSvg from '../../../docs/assets/brand/svg/favicon.svg?raw';
import Logo from '../components/Logo.astro';
import AskDocs from '../components/AskDocs.astro';
import CodeCopy from '../components/CodeCopy.astro';
import Analytics from '../components/Analytics.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import { links, url } from '../lib/links';

interface Props {
  title: string;
  description: string;
  /** Up to three questions shown when the docs assistant opens. */
  starterQuestions?: string[];
  type?: 'website' | 'article';
}

const {
  title,
  description,
  type = 'website',
  starterQuestions = [
    'How do I connect Claude Desktop to my IBM i?',
    'Which driver should I use: ODBC, JT400 or Mapepire?',
    'How does the server keep queries read-only?',
  ],
} = Astro.props;

const siteName = 'Db2 for i MCP Server';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const current = (prefix: string) => (path === url(prefix) || path.startsWith(url(prefix) + '/') ? 'page' : undefined);

const favicon = 'data:image/svg+xml,' + encodeURIComponent(faviconSvg);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Db2 for i MCP Server blog" href={url('/rss.xml')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Apply a saved theme before first paint. See ThemeSwitch.astro.
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.setAttribute('data-theme', theme);
      } catch {}
    </script>
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <slot name="head" />
    <Analytics />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href={url('/')} aria-label="db2i/mcp home">
          <Logo variant="lockup" height={20} />
        </a>
        <nav id="site-nav" aria-label="Main">
          <a href={url('/')} aria-current={path === url('/') ? 'page' : undefined}>Product</a>
          <a href={url('/business')} aria-current={current('/business')}>For business</a>
          <a href={url('/blog')} aria-current={current('/blog')}>Blog</a>
          <a href={links.docs}>Docs</a>
          <a href={links.github}>GitHub</a>
        </nav>
        <div class="tools">
          <ThemeSwitch />
          <button type="button" class="menu-toggle" aria-controls="site-nav" aria-expanded="false" aria-label="Open menu" data-menu-toggle>
            <span aria-hidden="true"></span>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="foot-top">
          <a class="brand" href={url('/')} aria-label="db2i/mcp home"><Logo variant="lockup" height={18} /></a>
          <nav class="foot-links" aria-label="Footer">
            <a href={links.docs}>Docs</a>
            <a href={url('/blog')}>Blog</a>
            <a href={links.changelog}>Changelog</a>
            <a href={links.github}>GitHub</a>
            <a href={links.npm}>npm</a>
            <a href={links.sponsor}>Sponsor</a>
          </nav>
        </div>
        <p class="legal">
          <span>mcp-server-db2i · MIT</span>
          <span>IBM, IBM i and Db2 are trademarks of International Business Machines Corporation. Not affiliated with IBM.</span>
        </p>
      </div>
    </footer>

    <AskDocs starterQuestions={starterQuestions} />
    <CodeCopy />
    <script>
      // Mobile menu: the button shows and hides the header nav.
      const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const nav = document.getElementById('site-nav');
      if (toggle && nav) {
        const set = (open: boolean) => {
          nav.classList.toggle('open', open);
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        };
        toggle.addEventListener('click', () => set(!nav.classList.contains('open')));
        nav.addEventListener('click', (event) => { if ((event.target as HTMLElement).closest('a')) set(false); });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && nav.classList.contains('open')) { set(false); toggle.focus(); }
        });
      }
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 8px; background: var(--surface); padding: 8px 12px; z-index: 10; }
  .skip:focus { left: 8px; }

  .site-header { position: sticky; top: 0; z-index: 5; background: var(--bg); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: var(--space-4) 28px; min-height: 64px; }
  .brand { display: inline-flex; align-items: center; color: var(--fg); text-decoration: none; margin-right: auto; }
  .brand:hover { color: var(--fg); }
  .site-header nav { display: flex; align-items: center; gap: 28px; font-size: 0.9rem; }
  .site-header nav a { display: inline-flex; align-items: center; min-height: 34px; color: var(--muted); text-decoration: none; white-space: nowrap; }
  .site-header nav a:hover, .site-header nav a[aria-current] { color: var(--fg); }
  .tools { display: flex; align-items: center; gap: 8px; }

  /* Two-line menu button, turning into a cross when open. Phones only. */
  .menu-toggle { display: none; width: 34px; height: 34px; padding: 0; background: none; border: 1px solid var(--line); border-radius: var(--radius-btn); color: var(--fg); cursor: pointer; place-items: center; }
  .menu-toggle span, .menu-toggle span::before { display: block; width: 16px; height: 1.5px; background: currentColor; position: relative; transition: transform 0.15s; }
  .menu-toggle span { transform: translateY(-3px); }
  .menu-toggle span::before { content: ''; position: absolute; left: 0; top: 6px; }
  .menu-toggle[aria-expanded='true'] span { transform: rotate(45deg); }
  .menu-toggle[aria-expanded='true'] span::before { top: 0; transform: rotate(-90deg); }

  @media (max-width: 759px) {
    .menu-toggle { display: inline-grid; }
    .site-header nav { display: none; position: absolute; left: 0; right: 0; top: 100%; flex-direction: column; align-items: stretch; gap: 0; padding: 4px var(--gutter) 16px; background: var(--bg); border-bottom: 1px solid var(--line-strong); font-size: 1.05rem; }
    .site-header nav.open { display: flex; }
    .site-header nav a { min-height: 48px; border-top: 1px solid var(--line); color: var(--fg); }
    .site-header nav a:first-child { border-top: 0; }
  }

  .site-footer { border-top: 1px solid var(--line); padding: var(--space-6) 0 var(--space-5); margin-top: var(--space-8); }
  .foot-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4) var(--space-6); }
  .foot-links { display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: 0.9rem; }
  .foot-links a { color: var(--muted); text-decoration: none; min-height: 0; }
  .foot-links a:hover { color: var(--fg); }
  .legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2) var(--space-6); margin: var(--space-5) 0 0; font: 11px/1.5 var(--font-mono); color: var(--muted); }
</style>
