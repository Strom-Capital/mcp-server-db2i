# Address of mcp-server-db2i in HTTP mode with OAuth (MCP_OAUTH_ENABLED=true).
# Its MCP endpoint is <MCP_SERVER_URL>/mcp.
MCP_SERVER_URL=http://localhost:3000

# Address users reach this app at. The OAuth callback is <APP_URL>/oauth/callback.
# A localhost address is always accepted by the server; any other one must be
# listed in the server's MCP_OAUTH_REDIRECT_URIS.
APP_URL=http://localhost:3001

# Encrypts the session cookie that holds the OAuth tokens. At least 32 characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Optional: one model key for everyone who signs in, kept on this server.
# A key a user enters in Settings is used instead.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: the provider and model a new user starts with.
# DEFAULT_PROVIDER=anthropic
# DEFAULT_MODEL=claude-sonnet-4-5
