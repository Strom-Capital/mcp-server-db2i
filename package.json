{
  "name": "mcp-server-db2i",
  "mcpName": "io.github.Strom-Capital/mcp-server-db2i",
  "version": "2.12.0",
  "description": "Read-only MCP server that lets AI assistants query IBM Db2 for i, with per-user sign-in, a library allowlist and an audit log",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-server-db2i": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "dev": "tsx --env-file=.env src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "typecheck": "tsc -p tsconfig.eslint.json"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ibm",
    "db2",
    "db2i",
    "as400",
    "iseries",
    "ibm-i",
    "jt400",
    "odbc",
    "jdbc",
    "http",
    "claude",
    "oauth",
    "mapepire",
    "read-only"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Strom-Capital/mcp-server-db2i.git"
  },
  "bugs": {
    "url": "https://github.com/Strom-Capital/mcp-server-db2i/issues"
  },
  "homepage": "https://db2i-mcp.com",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Strom-Capital"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.8",
    "node-sql-parser": "^5.4.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/ssh2": "^1.15.6",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "optionalDependencies": {
    "@ibm/mapepire-js": "^1.0.0",
    "node-jt400": "^7.0.1",
    "odbc": "^2.6.0",
    "ssh2": "^1.17.0"
  }
}
