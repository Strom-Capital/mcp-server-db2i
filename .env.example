# IBM DB2i MCP Server Configuration
# Copy this file to .env and fill in your values

# ===================
# Required Settings
# ===================

# IBM i hostname or IP address
DB2I_HOSTNAME=your-ibm-i-host.com

# IBM i username
DB2I_USERNAME=your-username

# IBM i password
DB2I_PASSWORD=your-password

# Read the username or password from a file instead, for example a Docker secret.
# A file wins over the plain variable.
# DB2I_USERNAME_FILE=/run/secrets/db2i_username
# DB2I_PASSWORD_FILE=/run/secrets/db2i_password

# Several IBM i systems: a YAML file with one profile per system.
# When set, it replaces every DB2I_* connection variable above and below.
# See docs/configuration.md#multiple-systems and examples/profiles.yaml
# DB2I_PROFILES=./profiles.yaml

# ===================
# Database Settings
# ===================

# Default schema/library (optional).
# Also used as the library list for execute_query (JDBC `libraries` or ODBC `DBQ`),
# unless the driver options already set it. With naming=sql, unqualified table names resolve here.
DB2I_SCHEMA=

# Database driver: odbc (default, npm `odbc` package with the IBM i Access ODBC
# driver, no Java), jt400 (JDBC via the optional node-jt400 package; needs a
# JDK when running npm install and a JRE at runtime) or mapepire (Mapepire over
# SSH; needs SSH access and Java on the IBM i, nothing locally)
DB2I_DRIVER=odbc

# Additional JDBC options for the jt400 and mapepire drivers (semicolon-separated)
# Example: naming=sql;date format=iso;time format=iso
DB2I_JDBC_OPTIONS=naming=sql;date format=iso

# Additional ODBC connection keywords for the odbc driver (semicolon-separated)
# Example: NAM=0;SSL=1;DBQ=,MYLIB,QGPL
DB2I_ODBC_OPTIONS=

# SSH and Mapepire settings for the mapepire driver (semicolon-separated).
# The SSH host key must match hostKey or ~/.ssh/known_hosts.
# Keys: transport, sshPort, hostKey, knownHostsFile, insecureHostKey, privateKeyFile,
#       javaPath, serverPath, maxJobs, idleTimeout, startupTimeout, requestTimeout
# Example: hostKey=SHA256:abc...xyz;maxJobs=2
# DB2I_MAPEPIRE_OPTIONS=

# ===================
# Transport Settings
# ===================

# Transport mode: stdio, http, or both (default: stdio)
# - stdio: For CLI/IDE integration (default, backwards compatible)
# - http: For web/agent integration with token auth
# - both: Run both transports simultaneously
MCP_TRANSPORT=stdio

# ===================
# HTTP Transport Settings (only used when MCP_TRANSPORT=http or both)
# ===================

# HTTP server port (default: 3000)
MCP_HTTP_PORT=3000

# HTTP server bind address (default: 127.0.0.1)
# Use 0.0.0.0 only with TLS enabled or behind a reverse proxy
MCP_HTTP_HOST=127.0.0.1

# Extra Host header names, comma-separated. Loopback is always allowed.
# Set this to the public hostname when MCP_HTTP_HOST is 0.0.0.0.
# MCP_ALLOWED_HOSTS=

# Behind a reverse proxy or tunnel, trust it so rate limits see each client's
# address from X-Forwarded-For: true, a hop count such as 1, or proxy addresses.
# Without it, every client shares the proxy's rate-limit budget.
# MCP_TRUST_PROXY=false

# Session mode (default: stateless)
# - stateless: one MCP server per request. Serves spec 2026-07-28 and 2025-era clients.
#   Database pools stay keyed by auth token.
# - stateful: deprecated. Keeps Mcp-Session-Id for 2025-era clients only.
MCP_SESSION_MODE=stateless

# Token lifetime in seconds (default: 3600 = 1 hour)
MCP_TOKEN_EXPIRY=3600

# Maximum concurrent sessions (default: 100)
MCP_MAX_SESSIONS=100

# CORS allowed origins (comma-separated, * for all, empty for same-origin only)
# Example: https://example.com,https://app.example.com
# MCP_CORS_ORIGINS=

# ===================
# HTTP Authentication Mode
# ===================

# Auth mode: required, token, or none (default: required)
# - required: Full /auth flow with per-user DB credentials (most secure)
# - token: Pre-shared static token, uses env DB credentials
# - none: No auth required, uses env DB credentials (for trusted networks only)
MCP_AUTH_MODE=required

# Static token for 'token' mode (generate with: openssl rand -hex 32)
# Required when MCP_AUTH_MODE=token
# MCP_AUTH_TOKEN=

# Allow MCP_AUTH_MODE=none when MCP_HTTP_HOST is not loopback (default: false)
# MCP_ALLOW_UNAUTHENTICATED_HTTP=false

# Hosts POST /auth may open a database connection to (comma-separated).
# When unset, only DB2I_HOSTNAME is accepted.
# MCP_AUTH_ALLOWED_DB_HOSTS=

# ===================
# OAuth for Remote Clients (claude.ai custom connectors)
# ===================

# Built-in OAuth 2.1 authorization server with an IBM i sign-in page.
# Requires MCP_AUTH_MODE=required and HTTPS at MCP_PUBLIC_URL.
# MCP_OAUTH_ENABLED=false

# External origin clients use, without a path. Its hostname joins the Host allowlist.
# MCP_PUBLIC_URL=https://mcp.example.com

# Redirect URIs clients may register (comma-separated; prefixes end in /*).
# Default: the claude.ai and claude.com connector callbacks, and Cursor's
# cursor://anysphere.cursor-mcp/oauth/callback. Setting this replaces the defaults.
# Loopback is always accepted.
# MCP_OAUTH_REDIRECT_URIS=

# Signing key for client IDs and sign-in requests (generate with: openssl rand -hex 32).
# Unset: random per process, so clients must register again after a restart.
# MCP_OAUTH_SECRET=

# Refresh token lifetime in seconds (default: 604800 = 7 days, 0 = no refresh tokens)
# MCP_OAUTH_REFRESH_EXPIRY=604800


# ===================
# TLS Settings (for HTTPS)
# ===================

# Enable built-in TLS (default: false)
# For production, either enable this or run behind a reverse proxy with TLS
MCP_TLS_ENABLED=false

# Path to TLS certificate (required if MCP_TLS_ENABLED=true)
MCP_TLS_CERT_PATH=

# Path to TLS private key (required if MCP_TLS_ENABLED=true)
MCP_TLS_KEY_PATH=

# ===================
# Logging Settings
# ===================

# Log level: debug, info, warn, error, fatal (default: info)
LOG_LEVEL=info

# Set to 'production' for JSON logs, otherwise pretty-printed
# NODE_ENV=production

# Override the log format (true = pretty, false = JSON) and colors (auto-detects a TTY)
# LOG_PRETTY=
# LOG_COLORS=

# Audit log: one JSON line per tool call. 'stderr', or a file path to append to
# MCP_AUDIT_LOG=
# Record statements as a sha256 hash (default) or as full text
# MCP_AUDIT_SQL=hash
# Include bound parameter values (default: only their count)
# MCP_AUDIT_PARAMS=false

# ===================
# Rate Limiting
# ===================

# Time window in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests allowed per window (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# Set to 'false' to disable rate limiting (default: true)
RATE_LIMIT_ENABLED=true

# Login attempts per IP address (POST /auth and the OAuth sign-in form share
# them), and their window in milliseconds.
# Always on; RATE_LIMIT_ENABLED does not affect it. (defaults: 5, 60000)
# AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
# AUTH_RATE_LIMIT_WINDOW_MS=60000

# Requests per IP address across all /oauth/* endpoints, and their window in
# milliseconds. Only read with MCP_OAUTH_ENABLED. Always on. (defaults: 120, 60000)
# OAUTH_RATE_LIMIT_MAX_REQUESTS=120
# OAUTH_RATE_LIMIT_WINDOW_MS=60000

# ===================
# Query Limits
# ===================

# Default number of rows returned (default: 1000)
QUERY_DEFAULT_LIMIT=1000

# Maximum rows allowed (default: 10000)
QUERY_MAX_LIMIT=10000

# Libraries execute_query may reference (comma-separated). Unset = no restriction.
# Unqualified names count as DB2I_SCHEMA (or the session schema from /auth).
# Add QSYS2 or SYSIBM here if catalog queries should be allowed.
# A query the server cannot parse is rejected while this is set.
# QUERY_ALLOWED_SCHEMAS=

# Parse execute_query with QSYS2.PARSE_STATEMENT before running it.
# Adds one round trip (often a few hundred milliseconds) to every query.
# Set to false or 0 to turn the check off. Default: on.
# QUERY_PARSE_CHECK=true

# ===================
# Tool Selection and Response Format
# ===================

# Comma-separated allowlist. If set, only these tools are registered.
# Valid built-ins: execute_query, list_schemas, list_tables, search_tables,
#        search_columns, describe_table, list_views, list_indexes, get_table_constraints,
#        validate_query, get_object_ddl, get_related_objects, get_journal_info,
#        profile_table, get_business_context
# Custom tool names and toolset:<name> are also valid once MCP_CUSTOM_TOOLS is set.
# MCP_TOOLS_ENABLED=

# Comma-separated denylist, applied after the allowlist
# Example: execute_query (metadata browsing only, no free-form SQL)
# MCP_TOOLS_DISABLED=

# YAML files or directories of read-only business SQL tools and table annotations.
# Example: ./examples/erp-tools
# MCP_CUSTOM_TOOLS=

# Re-read MCP_CUSTOM_TOOLS when the files change (true or 1)
# MCP_CUSTOM_TOOLS_WATCH=false

# Tool result text format: json (compact, default), pretty, or markdown
# MCP_RESPONSE_FORMAT=json
